# ── 依赖 ───────────────────────────────────────────────────────────────
node_modules/
.npm-cache/

# ── 运行时状态与本机配置（永不提交）────────────────────────────────────
state/
# 面板口令现在写到 <DSH_HOME>/stellar/panel-token.txt；这条防旧版残留
stellar-manager/panel-token.txt
stellar-manager/audit.jsonl
config.json
*.log
*.bak
*.bak-*
.installed-manifest.json
.installed-meta.json

# 语音库（用户个人音频素材，config.json 的 socialV2.voice.dir 指向此处）
audio/

# 迁移/清理备份
/_backups/

# 本机专用的隐私扫描规则（含真实 QQ 号/路径）
/scripts/privacy-rules.json

# ── 大体积演示视频：改由 Release 附件托管 ──────────────────────────────
/assets/project-intro.mp4

# ── 构建产物（exe 不进仓库，挂 Release 资产）──────────────────────────
/dist/
*.payload.zip

# ── 系统杂物 ───────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc

# Windows 某些组件会把缓存写到「字面量 %SystemDrive%」目录（测试跑完会冒出来，不是我们的文件）
/%SystemDrive%/
